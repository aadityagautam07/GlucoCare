# ==============================================================================
# GlucoCare — Environment Variables Example
# Duplicate this file to '.env.local' and customize values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB & Mongoose)
# ------------------------------------------------------------------------------
# Connection string for your MongoDB instance.
# Example local URI: mongodb://localhost:27017/glucocare
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/glucocare?retryWrites=true&w=majority
#
# NOTE: If MONGODB_URI is left blank or undefined, GlucoCare will automatically
# operate in zero-setup in-memory mode, pre-populated with realistic 14-day demo
# patient data (Eleanor Brooks).
MONGODB_URI=mongodb://localhost:27017/glucocare

# ------------------------------------------------------------------------------
# Authentication & Session Security (Jose / JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify patient session tokens (HS256).
# For production environments, generate a secure 256-bit random string, e.g.:
# openssl rand -base64 32
AUTH_SECRET=your-secure-random-secret-key-min-32-chars-change-me

# ------------------------------------------------------------------------------
# Application URL (Optional)
# ------------------------------------------------------------------------------
# Base URL for local development or production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

